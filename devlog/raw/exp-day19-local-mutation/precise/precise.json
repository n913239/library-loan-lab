1000","statusReason":"expected '2026-09-04T02:00:01.209Z' to be '2026-09-18T02:00:00.000Z' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["0"],"coveredBy":["0","1","2","3","4"],"location":{"end":{"column":60,"line":15},"start":{"column":27,"line":15}}},{"id":"60","mutatorName":"ArithmeticOperator","replacement":"loanDays / SECONDS_PER_DAY","statusReason":"expected '2026-09-04T02:00:00.000Z' to be '2026-09-18T02:00:00.000Z' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["0"],"coveredBy":["0","1","2","3","4"],"location":{"end":{"column":53,"line":15},"start":{"column":27,"line":15}}},{"id":"58","mutatorName":"ArithmeticOperator","replacement":"nowMs - loanDays * SECONDS_PER_DAY * 1000","statusReason":"expected '2026-08-21T02:00:00.000Z' to be '2026-09-18T02:00:00.000Z' // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"killedBy":["0"],"coveredBy":["0","1","2","3","4"],"location":{"end":{"column":60,"line":15},"start":{"column":19,"line":15}}}],"source":"// src/domain/due-at.js\n// 規格層決定 2:借出時把算好的 due_at 寫進 borrow_records(快照);借期由 routes 從 loan_policies 讀來當參數。\n// 規格層決定 3 同一套算法:due_at = now + loanDays × 86400 秒,純 UTC 秒差,不看日曆日。\n// 硬規則 1:now 從參數進來,這裡不准讀時鐘。\n// 硬規則 4:now 進來是 UTC 的 ISO-8601 字串,回傳也是(toISOString,固定帶毫秒、結尾 Z)。\n\nconst SECONDS_PER_DAY = 86400\n\nexport function dueAt(now, loanDays) {\n  if (typeof now !== 'string') throw new TypeError(`now 必須是 ISO-8601 字串:${now}`)\n  const nowMs = Date.parse(now)\n  if (Number.isNaN(nowMs)) throw new TypeError(`now 不是合法的 ISO-8601 字串:${now}`)\n  if (!Number.isInteger(loanDays) || loanDays <= 0) throw new TypeError(`loanDays 必須是正整數:${loanDays}`)\n\n  return new Date(nowMs + loanDays * SECONDS_PER_DAY * 1000).toISOString()\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"tests/local/due-at.test.js":{"tests":[{"id":"0","name":"dueAt B1: 借 14 天"},{"id":"1","name":"dueAt B2: 最小借期 1 天"},{"id":"2","name":"dueAt B3: 跨年"},{"id":"3","name":"dueAt B4: 毫秒保留"},{"id":"4","name":"dueAt B5: 不讀時鐘"},{"id":"5","name":"dueAt B6: now=%p → TypeError 昨天"},{"id":"6","name":"dueAt B6: now=%p → TypeError"},{"id":"7","name":"dueAt B6: now=%p → TypeError undefined"},{"id":"8","name":"dueAt B6: now=%p → TypeError null"},{"id":"9","name":"dueAt B6: now=%p → TypeError 1757988000000"},{"id":"10","name":"dueAt B6: now=%p → TypeError 2026-09-04T02:00:00.000Z"},{"id":"11","name":"dueAt B7: loanDays=%p → TypeError 0"},{"id":"12","name":"dueAt B7: loanDays=%p → TypeError -1"},{"id":"13","name":"dueAt B7: loanDays=%p → TypeError 1.5"},{"id":"14","name":"dueAt B7: loanDays=%p → TypeError NaN"},{"id":"15","name":"dueAt B7: loanDays=%p → TypeError Infinity"},{"id":"16","name":"dueAt B7: loanDays=%p → TypeError 14"},{"id":"17","name":"dueAt B7: loanDays=%p → TypeError undefined"},{"id":"18","name":"dueAt B7: loanDays=%p → TypeError null"}],"source":"import { describe, it, expect, vi, afterEach } from 'vitest'\nimport { dueAt } from '../../src/domain/due-at.js'\n\ndescribe('dueAt', () => {\n  afterEach(() => { vi.useRealTimers() })\n\n  it('B1: 借 14 天', () => {\n    expect(dueAt('2026-09-04T02:00:00Z', 14)).toBe('2026-09-18T02:00:00.000Z')\n  })\n\n  it('B2: 最小借期 1 天', () => {\n    expect(dueAt('2026-09-04T02:00:00Z', 1)).toBe('2026-09-05T02:00:00.000Z')\n  })\n\n  it('B3: 跨年', () => {\n    expect(dueAt('2026-12-25T00:00:00Z', 14)).toBe('2027-01-08T00:00:00.000Z')\n  })\n\n  it('B4: 毫秒保留', () => {\n    expect(dueAt('2026-09-04T02:00:00.123Z', 14)).toBe('2026-09-18T02:00:00.123Z')\n  })\n\n  it('B5: 不讀時鐘', () => {\n    vi.useFakeTimers()\n    vi.setSystemTime(new Date('2000-01-01T00:00:00Z'))\n\n    expect(dueAt('2026-09-04T02:00:00Z', 14)).toBe('2026-09-18T02:00:00.000Z')\n  })\n\n  it.each([\n    '昨天', '', undefined, null, 1757988000000, new Date('2026-09-04T02:00:00Z'),\n  ])('B6: now=%p → TypeError', (now) => {\n    expect(() => dueAt(now, 14)).toThrow(TypeError)\n  })\n\n  it.each([\n    0, -1, 1.5, NaN, Infinity, '14', undefined, null,\n  ])('B7: loanDays=%p → TypeError', (loanDays) => {\n    expect(() => dueAt('2026-09-04T02:00:00Z', loanDays)).toThrow(TypeError)\n  })\n})\n"},"tests/local/book-state.test.js":{"tests":[{"id":"19","name":"BOOK_STATES A1: [...BOOK_STATES].sort() → [\"available\", \"on_loan\"]"},{"id":"20","name":"BOOK_EVENTS A2: [...BOOK_EVENTS].sort() → [\"borrow\", \"return\"]"},{"id":"21","name":"A3: 白名單唯讀 BOOK_STATES 與 BOOK_EVENTS 都是 Frozen"},{"id":"22","name":"nextBookStatus A4: nextBookStatus(\"available\", \"borrow\") → \"on_loan\""},{"id":"23","name":"nextBookStatus A5: nextBookStatus(\"on_loan\", \"return\") → \"available\""},{"id":"24","name":"nextBookStatus A6: 借→還→借 鏈式呼叫"},{"id":"25","name":"nextBookStatus A7: nextBookStatus(\"on_loan\", \"borrow\") 丟 IllegalTransitionError"},{"id":"26","name":"nextBookStatus A8: nextBookStatus(\"available\", \"return\") 丟 IllegalTransitionError"},{"id":"27","name":"nextBookStatus A9: 錯誤物件內容 (接住 A7)"},{"id":"28","name":"nextBookStatus A10: 丟出的錯誤不是 TypeError"},{"id":"29","name":"nextBookStatus A11: 未知 status=\"reserved\", event=\"borrow\" → TypeError"},{"id":"30","name":"nextBookStatus A11: 未知 status=\"AVAILABLE\", event=\"borrow\" → TypeError"},{"id":"31","name":"nextBookStatus A11: 未知 status=\"\", event=\"borrow\" → TypeError"},{"id":"32","name":"nextBookStatus A11: 未知 status=\"undefined\", event=\"borrow\" → TypeError"},{"id":"33","name":"nextBookStatus A11: 未知 status=\"null\", event=\"borrow\" → TypeError"},{"id":"34","name":"nextBookStatus A11: 未知 status=\"0\", event=\"borrow\" → TypeError"},{"id":"35","name":"nextBookStatus A11: 未知 status=\"toString\", event=\"borrow\" → TypeError"},{"id":"36","name":"nextBookStatus A11: 未知 status=\"__proto__\", event=\"borrow\" → TypeError"},{"id":"37","name":"nextBookStatus A12: status=\"available\", event=\"reserve\" → TypeError"},{"id":"38","name":"nextBookStatus A12: status=\"available\", event=\"BORROW\" → TypeError"},{"id":"39","name":"nextBookStatus A12: status=\"available\", event=\"\" → TypeError"},{"id":"40","name":"nextBookStatus A12: status=\"available\", event=\"undefined\" → TypeError"},{"id":"41","name":"nextBookStatus A12: status=\"available\", event=\"null\" → TypeError"},{"id":"42","name":"nextBookStatus A12: status=\"available\", event=\"1\" → TypeError"},{"id":"43","name":"nextBookStatus A12: status=\"available\", event=\"toString\" → TypeError"},{"id":"44","name":"nextBookStatus A12: status=\"available\", event=\"constructor\" → TypeError"}],"source":"import { describe, it, expect } from 'vitest'\nimport { BOOK_STATES, BOOK_EVENTS, nextBookStatus, IllegalTransitionError } from '../../src/domain/book-state.js'\n\ndescribe('BOOK_STATES', () => {\n  it('A1: [...BOOK_STATES].sort() → [\"available\", \"on_loan\"]', () => {\n    expect([...BOOK_STATES].sort()).toEqual(['available', 'on_loan'])\n  })\n})\n\ndescribe('BOOK_EVENTS', () => {\n  it('A2: [...BOOK_EVENTS].sort() → [\"borrow\", \"return\"]', () => {\n    expect([...BOOK_EVENTS].sort()).toEqual(['borrow', 'return'])\n  })\n})\n\ndescribe('A3: 白名單唯讀', () => {\n  it('BOOK_STATES 與 BOOK_EVENTS 都是 Frozen', () => {\n    expect(Object.isFrozen(BOOK_STATES)).toBe(true)\n    expect(Object.isFrozen(BOOK_EVENTS)).toBe(true)\n  })\n})\n\ndescribe('nextBookStatus', () => {\n  it('A4: nextBookStatus(\"available\", \"borrow\") → \"on_loan\"', () => {\n    expect(nextBookStatus('available', 'borrow')).toBe('on_loan')\n  })\n\n  it('A5: nextBookStatus(\"on_loan\", \"return\") → \"available\"', () => {\n    expect(nextBookStatus('on_loan', 'return')).toBe('available')\n  })\n\n  it('A6: 借→還→借 鏈式呼叫', () => {\n    const results = []\n    let s = 'available'\n    s = nextBookStatus(s, 'borrow')\n    results.push(s)\n    s = nextBookStatus(s, 'return')\n    results.push(s)\n    s = nextBookStatus(s, 'borrow')\n    results.push(s)\n    expect(results).toEqual(['on_loan', 'available', 'on_loan'])\n  })\n\n  it('A7: nextBookStatus(\"on_loan\", \"borrow\") 丟 IllegalTransitionError', () => {\n    expect(() => nextBookStatus('on_loan', 'borrow')).toThrow(IllegalTransitionError)\n  })\n\n  it('A8: nextBookStatus(\"available\", \"return\") 丟 IllegalTransitionError', () => {\n    expect(() => nextBookStatus('available', 'return')).toThrow(IllegalTransitionError)\n  })\n\n  it('A9: 錯誤物件內容 (接住 A7)', () => {\n    let caught\n    try { nextBookStatus('on_loan', 'borrow') }\n    catch (e) { caught = e }\n\n    expect(caught).toBeInstanceOf(Error)\n    expect(caught.name).toBe('IllegalTransitionError')\n    expect(caught.status).toBe('on_loan')\n    expect(caught.event).toBe('borrow')\n    expect(caught.message).toContain('on_loan')\n    expect(caught.message).toContain('borrow')\n  })\n\n  it('A10: 丟出的錯誤不是 TypeError', () => {\n    let caught\n    try { nextBookStatus('on_loan', 'borrow') }\n    catch (e) { caught = e }\n\n    expect(caught).not.toBeInstanceOf(TypeError)\n  })\n\n  it.each([\n    'reserved', 'AVAILABLE', '', undefined, null, 0, 'toString', '__proto__',\n  ])('A11: 未知 status=\"%s\", event=\"borrow\" → TypeError', (status) => {\n    expect(() => nextBookStatus(status, 'borrow')).toThrow(TypeError)\n  })\n\n  it.each([\n    'reserve', 'BORROW', '', undefined, null, 1, 'toString', 'constructor',\n  ])('A12: status=\"available\", event=\"%s\" → TypeError', (event) => {\n    expect(() => nextBookStatus('available', event)).toThrow(TypeError)\n  })\n})\n"}},"projectRoot":"<lab>","config":{"testRunner":"vitest","vitest":{"dir":"tests/local","related":true},"mutate":["src/domain/book-state.js","src/domain/due-at.js"],"reporters":["clear-text","json"],"jsonReporter":{"fileName":"reports/precise.json"},"coverageAnalysis":"perTest","concurrency":4,"configFile":"stryker.precise.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportSco